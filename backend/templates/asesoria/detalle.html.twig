{% extends 'base.html.twig' %}

{% block title %}{{ firm.name }} — Aselto{% endblock %}

{% block body %}
    <h1>{{ firm.name }}</h1>
    <p>NIF {{ firm.taxId }}.</p>

    {% if invited %}
        <p>Hemos enviado la invitación. Caduca a los 7 días.</p>
    {% endif %}
    {% if error %}
        <p class="error" role="alert">Error: {{ error }}</p>
    {% endif %}

    <h2>Personas</h2>
    <ul>
        {% for member in members %}
            <li>
                {{ member.account.email }} ({{ member.role }})
                {% if isAdmin and member.id in grantedIds %}
                    · ve las entidades
                {% endif %}
            </li>
        {% endfor %}
    </ul>
    {% if permissionSaved %}
        <p>El permiso ha quedado guardado.</p>
    {% endif %}
    {% if permissionError %}
        <p class="error" role="alert">Error: {{ permissionError }}</p>
    {% endif %}
    {% if isAdmin %}
        {% for member in members %}
            {% if member.role == 'empleado' %}
                <form method="post" action="{{ path('advisory_employee_permission', {id: firm.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('permiso-entidades') }}">
                    <input type="hidden" name="membership_id" value="{{ member.id }}">
                    {% if member.id in grantedIds %}
                        <input type="hidden" name="granted" value="0">
                        <button type="submit">Retirar ver entidades</button>
                    {% else %}
                        <input type="hidden" name="granted" value="1">
                        <button type="submit">Conceder ver entidades</button>
                    {% endif %}
                </form>
            {% endif %}
        {% endfor %}
        <p class="ayuda">Sin esta concesión, el empleado no ve los nombres de las entidades vinculadas. Invitar entidades sigue reservado a quien administra. El segundo factor sigue siendo opcional.</p>
    {% endif %}

    {% if canViewClients %}
        <h2>Entidades vinculadas</h2>
        {% if clients is empty %}
            <p>Todavía no hay entidades vinculadas.</p>
        {% else %}
            <ul>
                {% for link in clients %}
                    <li>{{ link.fiscalEntity.legalName }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
    {% if isAdmin %}
        {% if entityInvited %}
            <p>Hemos enviado la invitación a la entidad. Caduca a los 7 días.</p>
        {% endif %}
        {% if clientError %}
            <p class="error" role="alert">Error: {{ clientError }}</p>
        {% endif %}
        <h2>Invitar entidad</h2>
        <form method="post" action="{{ path('advisory_invite_entity', {id: firm.id}) }}" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('invitar-entidad') }}">
            <label for="entity_email">Correo del titular (obligatorio)</label>
            <input id="entity_email" name="entity_email" type="email" required value="{{ clientEmail }}">
            <p class="ayuda">La persona entra con este correo para aceptar. Si esa entidad ya tiene una asesoría activa, no podrá vincularse. El segundo factor sigue siendo opcional.</p>
            <button type="submit">Invitar entidad</button>
        </form>

        <h2>Invitar empleado</h2>
        <form method="post" action="{{ path('advisory_invite', {id: firm.id}) }}" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('invitar-asesoria') }}">
            <label for="email">Correo (obligatorio)</label>
            <input id="email" name="email" type="email" required value="{{ email }}">
            <p class="ayuda">Si crea la cuenta con este correo, al confirmarla queda en la asesoría. Si ya la tiene, entra con ese correo. El segundo factor sigue siendo opcional.</p>
            <button type="submit">Invitar</button>
        </form>
    {% endif %}

    <p><a href="{{ path('advisories') }}">Volver a las asesorías</a></p>
{% endblock %}
