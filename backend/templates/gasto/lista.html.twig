{% extends 'base.html.twig' %}

{% block title %}Gastos — Aselto{% endblock %}

{% block body %}
    <h1>Gastos</h1>
    {% if not entityReady %}
        <p>Elige antes una entidad fiscal.</p>
        <p><a href="{{ path('fiscal_entities') }}">Entidades</a></p>
    {% else %}
        <p>Registra facturas recibidas, tickets y otros gastos. La base y la cuota salen de las líneas. El estado de pago sale de los pagos anotados. Solo un gasto revisado es definitivo. Un posible duplicado se avisa y no se borra. Una propuesta mensual nace en borrador.</p>
        {% if error %}
            <p class="error" role="alert">Error: {{ error }}</p>
        {% endif %}
        {% if savedExpense %}
            <p class="ok">El gasto ha quedado guardado.</p>
        {% endif %}
        {% if savedCategory %}
            <p class="ok">La categoría ha quedado guardada.</p>
        {% endif %}
        {% if savedDeduction %}
            <p class="ok">La deducibilidad ha quedado guardada.</p>
        {% endif %}
        {% if savedPayment %}
            <p class="ok">El pago ha quedado anotado.</p>
        {% endif %}
        {% if savedReview %}
            <p class="ok">La revisión ha quedado guardada.</p>
        {% endif %}
        {% if savedRecurrence %}
            <p class="ok">La recurrencia ha quedado guardada.</p>
        {% endif %}
        {% if savedProposal %}
            <p class="ok">La propuesta ha quedado creada. Revisa el borrador antes de darlo por definitivo.</p>
        {% endif %}

        <h2>Categorías</h2>
        <ul>
            {% for category in allCategories %}
                <li>
                    {{ category.name }}
                    {% if category.isDefault %}(de serie){% endif %}
                    {% if category.isActive %}
                        <form method="post" action="{{ path('expense_category_deactivate', {id: category.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('desactivar-categoria') }}">
                            <button type="submit">Desactivar</button>
                        </form>
                    {% else %}
                        Desactivada
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <form method="post" action="{{ path('expense_category') }}" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('categoria') }}">
            <label for="nombre">Nueva categoría</label>
            <input id="nombre" name="nombre" type="text" maxlength="60" required>
            <button type="submit">Añadir categoría</button>
        </form>

        <h2>Gastos registrados</h2>
        {% if expenses is empty %}
            <p>Todavía no hay gastos.</p>
        {% else %}
            <ul>
                {% for expense in expenses %}
                    <li>
                        {{ expense.documentNo }}
                        · {{ expense.kindLabel }}
                        · {{ expense.snapshotName }} ({{ expense.snapshotTaxId }})
                        · {{ expense.snapshotCategory }}
                        · {{ expense.paymentMethodLabel }}
                        · {{ expense.issuedOn|date('d/m/Y') }}
                        · base {{ expense.base|euros }}
                        · cuota {{ expense.tax|euros }}
                        · total {{ expense.total|euros }}
                        <p>Revisión: {{ expense.reviewLabel }}. {{ expense.standingLabel }}{% if expense.reviewReason %} — {{ expense.reviewReason }}{% endif %}</p>
                        <p>Pago: {{ expense.paymentStatusLabel }}. Anotado: {{ expense.paid|euros }}. Saldo: {{ expense.balance|euros }}</p>
                        {% for other in duplicateNotes[expense.id]|default([]) %}
                            <p class="aviso">Posible duplicado: {{ other.documentNo }}, {{ other.issuedOn|date('d/m/Y') }}, {{ other.total|euros }}, {{ other.reviewLabel }}. El gasto no se ha borrado.</p>
                        {% endfor %}
                        {% if expense.sourceExpense %}
                            <p>Propuesta de {{ expense.sourceExpense.documentNo }}. No es definitiva hasta revisarla.</p>
                        {% endif %}
                        {% if expense.monthly %}
                            <p>Mensual.</p>
                        {% endif %}
                        {% if expense.current %}
                            <form method="post" action="{{ path('expense_recurrence', {id: expense.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('recurrencia') }}">
                                {% if expense.monthly %}
                                    <input type="hidden" name="periodo" value="ninguna">
                                    <button type="submit">Quitar recurrencia</button>
                                {% else %}
                                    <input type="hidden" name="periodo" value="mensual">
                                    <button type="submit">Marcar como mensual</button>
                                {% endif %}
                            </form>
                            {% if expense.monthly %}
                                <form method="post" action="{{ path('expense_proposal', {id: expense.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('propuesta') }}">
                                    <button type="submit">Crear propuesta</button>
                                </form>
                            {% endif %}
                        {% endif %}
                        {% if expense.acceptsPayment %}
                            <form method="post" action="{{ path('expense_pay', {id: expense.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('pago') }}">
                                <input type="hidden" name="payment_token" value="{{ paymentToken }}">
                                <label for="importe-pago-{{ expense.id }}">Importe del pago</label>
                                <input id="importe-pago-{{ expense.id }}" name="importe" type="text" inputmode="decimal" required>
                                <label for="fecha-pago-{{ expense.id }}">Fecha del pago</label>
                                <input id="fecha-pago-{{ expense.id }}" name="fecha" type="date" required>
                                <label for="metodo-pago-{{ expense.id }}">Método del pago</label>
                                <select id="metodo-pago-{{ expense.id }}" name="metodo" required>
                                    {% for code, label in methods %}
                                        <option value="{{ code }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                                <label for="referencia-pago-{{ expense.id }}">Referencia</label>
                                <input id="referencia-pago-{{ expense.id }}" name="referencia" type="text" maxlength="80">
                                <button type="submit">Anotar pago</button>
                            </form>
                        {% endif %}
                        {% if expense.current %}
                            <form method="post" action="{{ path('expense_review', {id: expense.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('revision') }}">
                                <label for="estado-{{ expense.id }}">Revisión</label>
                                <select id="estado-{{ expense.id }}" name="estado" required>
                                    {% if expense.reviewState == 'borrador' %}
                                        <option value="revisado">Revisado</option>
                                        <option value="rechazado">Rechazado</option>
                                    {% endif %}
                                    <option value="anulado">Anulado</option>
                                </select>
                                <label for="motivo-revision-{{ expense.id }}">Motivo, si rechazas o anulas</label>
                                <input id="motivo-revision-{{ expense.id }}" name="motivo" type="text" maxlength="240">
                                <button type="submit">Guardar revisión</button>
                            </form>
                        {% endif %}
                        <p>Base: {{ expense.baseDecisionLabel }}{% if expense.baseReason %} — {{ expense.baseReason }}{% endif %}</p>
                        {% if expense.current %}
                        <form method="post" action="{{ path('expense_deduction', {id: expense.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('deducibilidad') }}">
                            <input type="hidden" name="parte" value="base">
                            <label for="deducible-base-{{ expense.id }}">La base es deducible</label>
                            <select id="deducible-base-{{ expense.id }}" name="deducible" required>
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                            <label for="motivo-base-{{ expense.id }}">Motivo de la base</label>
                            <input id="motivo-base-{{ expense.id }}" name="motivo" type="text" maxlength="240" required>
                            <button type="submit">Guardar base</button>
                        </form>
                        {% endif %}
                        <p>Cuota: {{ expense.taxDecisionLabel }}{% if expense.taxReason %} — {{ expense.taxReason }}{% endif %}</p>
                        {% if expense.current %}
                        <form method="post" action="{{ path('expense_deduction', {id: expense.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('deducibilidad') }}">
                            <input type="hidden" name="parte" value="cuota">
                            <label for="deducible-cuota-{{ expense.id }}">La cuota es deducible</label>
                            <select id="deducible-cuota-{{ expense.id }}" name="deducible" required>
                                <option value="1">Sí</option>
                                <option value="0">No</option>
                            </select>
                            <label for="motivo-cuota-{{ expense.id }}">Motivo de la cuota</label>
                            <input id="motivo-cuota-{{ expense.id }}" name="motivo" type="text" maxlength="240" required>
                            <button type="submit">Guardar cuota</button>
                        </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <h2>Nuevo gasto</h2>
        {% if suppliers is empty %}
            <p>Crea antes un proveedor.</p>
            <p><a href="{{ path('contacts') }}">Contactos</a></p>
        {% else %}
            <form method="post" action="{{ path('expenses') }}" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('gasto') }}">
                <label for="tipo">Tipo (obligatorio)</label>
                <select id="tipo" name="tipo" required>
                    {% for code, label in kinds %}
                        <option value="{{ code }}">{{ label }}</option>
                    {% endfor %}
                </select>
                <label for="contacto">Proveedor (obligatorio)</label>
                <select id="contacto" name="contacto" required>
                    {% for supplier in suppliers %}
                        <option value="{{ supplier.id }}">{{ supplier.displayName }} ({{ supplier.taxId }})</option>
                    {% endfor %}
                </select>
                <label for="categoria">Categoría (obligatoria)</label>
                <select id="categoria" name="categoria" required>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                </select>
                <label for="metodo">Método de pago (obligatorio)</label>
                <select id="metodo" name="metodo" required>
                    {% for code, label in methods %}
                        <option value="{{ code }}">{{ label }}</option>
                    {% endfor %}
                </select>
                <label for="numero">Número (obligatorio)</label>
                <input id="numero" name="numero" type="text" maxlength="40" required>
                <label for="fecha">Fecha (obligatoria)</label>
                <input id="fecha" name="fecha" type="date" required>
                <h3>Líneas</h3>
                {% for n in 1..2 %}
                    <fieldset>
                        <label>Descripción <input name="descripcion[]" type="text" maxlength="180"></label>
                        <label>Cantidad <input name="cantidad[]" type="text" inputmode="decimal"></label>
                        <label>Precio <input name="precio[]" type="text" inputmode="decimal"></label>
                        <label>Impuesto (%) <input name="iva[]" type="text" inputmode="decimal"></label>
                        <label>Retención (%) <input name="retencion[]" type="text" inputmode="decimal"></label>
                    </fieldset>
                {% endfor %}
                <p class="ayuda">El porcentaje es el de la factura recibida. Aselto no calcula aquí el modelo fiscal. Las líneas vacías no se guardan.</p>
                <button type="submit">Guardar gasto</button>
            </form>
        {% endif %}
    {% endif %}
{% endblock %}
