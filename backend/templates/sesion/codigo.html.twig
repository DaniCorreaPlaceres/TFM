{% extends 'base.html.twig' %}

{% block title %}Código de acceso — Aselto{% endblock %}

{% block body %}
    <h1>Código de acceso</h1>
    <p>Escribe el código de tu aplicación o un código de recuperación.</p>

    {% if error %}
        <p class="error" role="alert">Error: {{ error }}</p>
    {% endif %}

    <form method="post" action="{{ path('account_login_code') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('codigo') }}">
        <label for="code">Código (obligatorio)</label>
        <input id="code" name="code" type="text" inputmode="text" autocomplete="one-time-code" required>
        <button type="submit">Comprobar</button>
    </form>
{% endblock %}