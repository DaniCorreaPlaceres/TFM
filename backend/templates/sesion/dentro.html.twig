{% extends 'base.html.twig' %}

{% block title %}Inicio — Aselto{% endblock %}

{% block body %}
    <h1>Inicio</h1>
    <p class="subtitulo">Sesión de {{ email }}.</p>

    {% if entityName %}
        <section class="rejilla" aria-label="Tu situación">
            <article class="tarjeta">
                <h2>Entidad</h2>
                <p>Entidad activa: {{ entityName }}.</p>
                <a class="boton secundario" href="{{ path('fiscal_entities') }}">Ver entidades</a>
                <p><a href="{{ path('contacts') }}">Contactos</a></p>
            </article>
            <article class="tarjeta">
                <h2>Asesoría</h2>
                {% if advisoryName %}
                    <p>Asesoría activa: {{ advisoryName }}.</p>
                {% else %}
                    <p>Esta entidad todavía no tiene una asesoría.</p>
                {% endif %}
                <a class="boton" href="{{ path('advisories') }}">Mi asesoría</a>
            </article>
        </section>
    {% else %}
        <section class="tarjeta paso">
            <h2>Empieza por tu entidad</h2>
            <p>Todavía no has elegido una entidad fiscal.</p>
            <p>La entidad es el titular de la información. Puedes tener varias y elegir cuál está activa.</p>
            <a class="boton" href="{{ path('fiscal_entities') }}">Crear o elegir entidad</a>
        </section>
    {% endif %}

    <section class="rejilla" aria-label="Lo que todavía no tiene datos">
        <article class="tarjeta">
            <h2>Ingresos</h2>
            <p>Los ingresos de la entidad activa están en su lista.</p>
            <a href="{{ path('incomes') }}">Ingresos y gastos</a>
        </article>
        <article class="tarjeta">
            <h2>Gastos</h2>
            <p>Los gastos de la entidad activa están en su lista.</p>
            <a href="{{ path('expenses') }}">Ver gastos</a>
        </article>
        <article class="tarjeta">
            <h2>Documentos</h2>
            <p>Añadir una factura o un ticket estará aquí cuando se puedan subir archivos.</p>
            <a href="{{ path('product_documents') }}">Ver documentos</a>
        </article>
    </section>

    <section class="tarjeta">
        <h2>Tu cuenta</h2>
        {% if secondFactor %}
            <p>El segundo factor está activo.</p>
        {% else %}
            <p>El segundo factor es opcional.</p>
        {% endif %}
        <p><a href="{{ path('account_second_factor') }}">Segundo factor</a></p>

        {% if othersClosed %}
            <p class="ok">Las demás sesiones se han cerrado.</p>
        {% endif %}
        <form method="post" action="{{ path('account_close_other_sessions') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('cerrar-sesiones') }}">
            <button class="secundario" type="submit">Cerrar las demás sesiones</button>
        </form>
        <p class="ayuda">La sesión actual sigue abierta.</p>
    </section>
{% endblock %}
