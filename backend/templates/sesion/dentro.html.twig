{% extends 'base.html.twig' %}

{% block title %}Sesión — Aselto{% endblock %}

{% block body %}
    <h1>Has entrado</h1>
    <p>Sesión de {{ email }}.</p>
    {% if entityName %}
        <p>Entidad activa: {{ entityName }}.</p>
    {% else %}
        <p>Todavía no has elegido una entidad fiscal.</p>
    {% endif %}
    {% if advisoryName %}
        <p>Asesoría activa: {{ advisoryName }}.</p>
    {% endif %}
    <p><a href="{{ path('fiscal_entities') }}">Entidades</a></p>
    {% if entityName %}
        <p><a href="{{ path('contacts') }}">Contactos</a></p>
        <p><a href="{{ path('incomes') }}">Ingresos y gastos</a></p>
    {% endif %}
    <p><a href="{{ path('advisories') }}">Asesorías</a></p>
    {% if secondFactor %}
        <p>El segundo factor está activo.</p>
    {% endif %}
    <p><a href="{{ path('account_second_factor') }}">Segundo factor</a></p>

    {% if othersClosed %}
        <p>Las demás sesiones se han cerrado.</p>
    {% endif %}
    <form method="post" action="{{ path('account_close_other_sessions') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('cerrar-sesiones') }}">
        <button type="submit">Cerrar las demás sesiones</button>
    </form>
    <p class="ayuda">La sesión actual sigue abierta.</p>

    <form method="post" action="{{ path('account_logout') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('salir') }}">
        <button type="submit">Salir</button>
    </form>
{% endblock %}
