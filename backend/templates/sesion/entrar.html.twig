{% extends 'base.html.twig' %}

{% block title %}Entrar — Aselto{% endblock %}

{% block body %}
    <h1>Entrar</h1>

    {% if updated %}
        <p>Contraseña actualizada. Ya puedes entrar.</p>
    {% endif %}

    {% if error %}
        <p class="error" role="alert">Error: {{ error }}</p>
    {% endif %}

    <form method="post" action="{{ path('account_login') }}" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('entrar') }}">

        <label for="email">Correo electrónico (obligatorio)</label>
        <input id="email" name="email" type="email" autocomplete="username" required value="{{ email }}">

        <label for="password">Contraseña (obligatorio)</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>

        <button type="submit">Entrar</button>
    </form>

    <p><a href="{{ path('account_recover') }}">He olvidado mi contraseña</a></p>
    <p><a href="{{ path('account_register') }}">Crear cuenta</a></p>
{% endblock %}
