<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Aselto{% endblock %}</title>
    {% block meta %}{% endblock %}
    <link rel="stylesheet" href="/estilos.css?v=4">
</head>
<body>
    {% block cuerpo %}
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {% if app.user %}
        {% set ruta = app.request.attributes.get('_route') ?? '' %}
        <div class="app">
            <aside class="barra">
                <a class="marca-app" href="{{ path('account_session') }}">
                    <span class="monograma" aria-hidden="true">A</span>
                    <span>Aselto</span>
                </a>
                <nav class="menu" aria-label="Secciones">
                    <a href="{{ path('account_session') }}" {% if ruta == 'account_session' %}aria-current="page"{% endif %}>
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z"/></svg>
                        Inicio
                    </a>
                    <a href="{{ path('incomes') }}" {% if ruta starts with 'income' %}aria-current="page"{% endif %}>
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 19V5M4 19h16M8 16v-4M12 16V8M16 16v-6"/></svg>
                        Ingresos y gastos
                    </a>
                    <a href="{{ path('product_documents') }}" {% if ruta == 'product_documents' %}aria-current="page"{% endif %}>
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v6h6"/></svg>
                        Documentos
                    </a>
                    <a href="{{ path('advisories') }}" {% if ruta starts with 'advisory' %}aria-current="page"{% endif %}>
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM16.5 11a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zM3.5 19v-1.2A3.8 3.8 0 0 1 7.3 14h1.4a3.8 3.8 0 0 1 3.8 3.8V19M14 19v-1a3 3 0 0 1 3-3h.8A2.7 2.7 0 0 1 20.5 17.7V19"/></svg>
                        Mi asesoría
                    </a>
                    <a href="{{ path('product_help') }}" {% if ruta == 'product_help' %}aria-current="page"{% endif %}>
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.2 2.4c-.7.3-1.2.8-1.2 1.6V14M12 17h.01"/></svg>
                        Ayuda
                    </a>
                </nav>
            </aside>
            <div class="columna">
                <header class="cabecera">
                    <p class="quien">{{ app.user.email }}</p>
                    <a href="{{ path('fiscal_entities') }}" {% if ruta starts with 'fiscal_entit' %}aria-current="page"{% endif %}>Entidades</a>
                    <form method="post" action="{{ path('account_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('salir') }}">
                        <button class="secundario" type="submit">Salir</button>
                    </form>
                </header>
                <main id="contenido">
    {% else %}
        <div class="puerta">
            <aside class="puerta-lado">
                <p class="puerta-marca"><span class="monograma" aria-hidden="true">A</span> Aselto</p>
                <p class="puerta-claim">Tus finanzas bajo control</p>
                <p>La actividad del autónomo y el trabajo de la asesoría, en el mismo sitio. Cada entidad queda separada.</p>
            </aside>
            <main id="contenido">
                <a class="marca-puerta" href="{{ path('landing') }}">
                    <span class="monograma" aria-hidden="true">A</span>
                    <span class="nombre">Aselto</span>
                    <span class="eslogan">Tus finanzas bajo control</span>
                </a>
    {% endif %}
                {% block body %}{% endblock %}
    {% if app.user %}
                </main>
            </div>
        </div>
    {% else %}
            </main>
        </div>
    {% endif %}
    {% endblock %}
</body>
</html>
