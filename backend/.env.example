# Valores locales de desarrollo. No definir secretos de produccion.
# Las variables reales del contenedor tienen prioridad sobre este archivo.
# Copia este fichero a .env si arrancas fuera de Compose. Compose ya inyecta las suyas.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://app:app@mysql:3306/app?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> redis ###
REDIS_URL=redis://redis:6379
###< redis ###
